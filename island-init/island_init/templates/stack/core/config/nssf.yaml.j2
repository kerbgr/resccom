################################################################################
# ResCCOM 1.1-a — NSSF (Network Slice Selection Function)
# Derived from upstream open5gs/open5gs configs/open5gs/nssf.yaml.in (v2.8.0).
# Single default slice (SST 1) is all M1 needs.
################################################################################
logger:
  file:
    path: /opt/open5gs/var/log/open5gs/nssf.log
{%- if log_level != "info" %}
  level: {{ log_level }}
{%- endif %}

global:
  max:
    ue: 1024

nssf:
  sbi:
    server:
      # 3.3-c v2d: FQDN as the primary listener, default port 80 -- see
      # ausf.yaml.j2's comment for the full reasoning (identical here;
      # found live, keeping explicit 7777 broke SEPP's cross-island
      # forwarding specifically).
      - address: {{ nssf_fqdn }}
    client:
      nrf:
        - uri: http://{{ nrf_fqdn }}
      nsi:
        - uri: http://{{ nrf_fqdn }}
          s_nssai:
            sst: 1
