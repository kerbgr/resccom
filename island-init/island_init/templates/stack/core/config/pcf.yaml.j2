################################################################################
# ResCCOM 1.1-a — PCF (Policy and Charging Function)
# Derived from upstream open5gs/open5gs configs/open5gs/pcf.yaml.in (v2.8.0).
# db_uri points at the compose "mongo" service — no credentials embedded.
################################################################################
db_uri: mongodb://mongo/open5gs
logger:
  file:
    path: /opt/open5gs/var/log/open5gs/pcf.log
{%- if log_level != "info" %}
  level: {{ log_level }}
{%- endif %}

global:
  max:
    ue: 1024

pcf:
  sbi:
    # 3.3-c v2d: PCF's own listener stays a plain core_net IP, matching
    # upstream (nrf.yaml.j2's comment has the full reasoning). Its
    # client.nrf.uri becomes the FQDN like every other NF's.
    server:
      - address: {{ pcf_ip }}
        port: 7777
    client:
      nrf:
        - uri: http://{{ nrf_fqdn }}
  metrics:
    server:
      - address: {{ pcf_ip }}
        port: 9090
