################################################################################
# ResCCOM 1.1-a — NRF (NF Repository Function)
# Derived from upstream open5gs/open5gs configs/open5gs/nrf.yaml.in (v2.8.0).
# PLMN {{ mcc }}/{{ mnc }} (rendered from island.yaml by island-init
# render — do not hand-edit).
################################################################################
logger:
  file:
    path: /opt/open5gs/var/log/open5gs/nrf.log
{%- if log_level != "info" %}
  level: {{ log_level }}
{%- endif %}

global:
  max:
    ue: 1024

nrf:
  serving:
    - plmn_id:
        mcc: {{ mcc }}
        mnc: {{ mnc }}
  sbi:
    server:
      # 3.3-c v2d: matches upstream's own home-PLMN roaming example
      # (configs/examples/5gc-no-scp-sepp2-001-01.yaml.in) exactly -- the
      # FQDN is NRF's *only* listener (upstream comments out its own
      # IP:7777 line here), default port 80. The 3.3-c v2b/v2c
      # peer-conditional second listener this replaced was a workaround
      # for a visited AMF's own FQDN-only discovery client defaulting to
      # port 80 against an NRF that otherwise only listened on 7777 --
      # moot now that the FQDN *is* the listener: extra_hosts
      # (compose.yaml.j2) resolves it to {{ nrf_ip }} for every core
      # container, peered or not.
      - address: {{ nrf_fqdn }}
