# ResCCOM 1.3-c — services-stack-level secrets (loaded automatically by
# `docker compose` from `.env` in this directory).
#
# Copy to `.env` here and replace the value — `.env` is gitignored (see
# ../../.gitignore's `*.env` / `!*.example.env` rule), this file is the
# checked-in placeholder only. Must equal
# config/matrix-synapse/secrets.example.yaml's (copied to
# data/matrix-synapse/secrets.yaml) database.args.password — same
# credential, two places that can't share a single source because
# compose ${VAR} substitution doesn't reach into a bind-mounted file's
# contents. See stack/services/README.md.
MATRIX_DB_PASSWORD=changeme
