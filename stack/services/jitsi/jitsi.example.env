# ResCCOM 1.3-d — Jitsi Meet local config + secrets template.
#
# Copy to `.env` in this directory and replace every `changeme` value —
# `.env` is gitignored (see ../../../.gitignore's `*.env` /
# `!*.example.env` rule), this file is the checked-in placeholder only.
# Password-shaped values were generated with `openssl rand -hex 16` for
# this task's own verification and never left this machine — that's
# upstream's own gen-passwords.sh recipe (see README.md), just applied
# by hand instead of running that script in place.

# Where compose.yaml's ${CONFIG}/* bind mounts land — gitignored (root
# .gitignore's blanket `data/` rule), holds real per-deployment state
# (prosody's user DB, uploaded avatars, etc).
CONFIG=./data

TZ=UTC
HTTP_PORT=8000
HTTPS_PORT=8443
# Upstream's own default (8080) collides with stack/services/nomad's
# admin dashboard on this same host — both are only host-published for
# local operator convenience (127.0.0.1-scoped, the UE never uses this
# port), so this just needs to be free, not any particular value.
JVB_COLIBRI_PORT=18080

# Pinned explicitly rather than relying on compose.yaml's own fallback
# default (CLAUDE.md: version-pin everything) — see README.md "Versions".
JITSI_IMAGE_VERSION=stable-11146-2

# No TLS in this lab profile (matches every other component in
# stack/services) — a real deployment terminates TLS at whatever fronts
# this instead of here.
DISABLE_HTTPS=1
ENABLE_HTTP_REDIRECT=0
ENABLE_LETSENCRYPT=0

PUBLIC_URL=https://talk.island

# Fixed services_net addresses (compose.yaml's own defaults already
# match these — see its header comment — repeated here as the single
# place an operator would actually change them).
GATEWAY_SERVICES_NET_IP=10.46.0.30
JVB_SERVICES_NET_IP=10.46.0.31
COTURN_SERVICES_NET_IP=10.46.0.32

# Must equal JVB_SERVICES_NET_IP above — this is what JVB embeds into
# the ICE candidates it hands the browser; the two are separate
# variables (upstream's own JVB_ADVERTISE_IPS, not something this repo
# invented) only because JVB_ADVERTISE_IPS supports a comma-separated
# list for multi-address setups this one doesn't need.
JVB_ADVERTISE_IPS=10.46.0.31

# Offline/LAN deployment: skip STUN's own "discover my public IP" step
# entirely (there is no public IP to discover) rather than pointing it
# at any address at all — see README.md "STUN/TURN scoped to local
# subnets".
JVB_DISABLE_STUN=true

# Point every client-facing STUN/TURN hint at our own coturn (must equal
# COTURN_SERVICES_NET_IP above) — never upstream's own default
# (Google's public STUN servers), so nothing here has a WAN dependency
# by construction, not by an operator remembering to override a default.
JVB_STUN_SERVERS=10.46.0.32:3478
STUN_HOST=10.46.0.32
STUN_PORT=3478
TURN_HOST=10.46.0.32
TURN_PORT=3478
TURN_TRANSPORT=udp
# Must equal coturn's --static-auth-secret in compose.yaml's `command:`
# (same value, read from this same variable — not duplicated).
TURN_CREDENTIALS=changeme

JICOFO_AUTH_PASSWORD=changeme
JVB_AUTH_PASSWORD=changeme
JIGASI_XMPP_PASSWORD=changeme
JIGASI_TRANSCRIBER_PASSWORD=changeme
JIBRI_RECORDER_PASSWORD=changeme
JIBRI_XMPP_PASSWORD=changeme
