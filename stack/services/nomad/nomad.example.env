# ResCCOM 1.3-b — Project NOMAD local config (secrets + the one path
# compose.yaml needs as an absolute value).
#
# Copy to `.env` in this directory and replace every value below with your
# own — `.env` is gitignored (see ../../../.gitignore's `*.env` /
# `!*.example.env` rule), this file is the checked-in placeholder only.
# Real values used for this task's own verification were generated with
# `openssl rand -hex 16` (APP_KEY) and `openssl rand -base64 24` (passwords)
# and never left this machine.

# Must be an absolute path — compose.yaml bind-mounts $NOMAD_DATA_DIR/storage
# into the admin container, which then bind-mounts that SAME host path into
# every child app container it creates (Kiwix, etc.), see compose.yaml's
# header comment for why this can't be a named volume. Defaults to this
# directory's own (gitignored) `data/` folder; override for a real
# deployment. Holds real content (ZIMs, etc.) — sized accordingly, not
# something to point at limited disk.
NOMAD_DATA_DIR=changeme-absolute-path-e.g.-/opt/project-nomad

# Admin server session/encryption key. Must be >=16 chars or the admin
# container refuses to start.
APP_KEY=changeme-generate-your-own-16-char-key

# Where you'll reach the admin UI from — used for links/redirects it
# generates. The Command Center is an operator tool, not something this
# task maps a .island name to (only its child apps' content is), so this
# is the host itself, the way an operator sitting at the island's own
# node would reach it.
URL=http://localhost:8080

# MySQL. DB_PASSWORD must equal MYSQL_PASSWORD (same credential, two
# services' env vars).
MYSQL_ROOT_PASSWORD=changeme
MYSQL_PASSWORD=changeme
DB_PASSWORD=changeme
